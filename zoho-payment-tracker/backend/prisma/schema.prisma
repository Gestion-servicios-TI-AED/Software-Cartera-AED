generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Opportunity {
  id                   String    @id @default(uuid())
  zohoId               String    @unique
  dealName             String
  stage                String?
  contactName          String?
  contactEmail         String?
  contactPhone         String?
  contactId            String?
  accountName          String?
  referenciaRecaudo    String?
  pagoSeparacion       DateTime?
  fechaInicioPlanPagos DateTime?

  // Campos financieros dinámicos (todos los currency fields de Zoho)
  camposFinancieros Json?

  // Secciones completas del CRM
  seccionInmueble   Json?
  seccionCotizacion Json?

  // Subforms de Zoho (array de filas)
  formaPago     Json?
  propuestaPago Json?

  // Control de sincronización
  lastSyncedAt DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model InventarioItem {
  id                String  @id @default(uuid())
  zohoId            String  @unique
  nombre            String?
  proyecto          String?
  torre             String?
  piso              String?
  categoria         String?
  estado            String?
  referenciaRecaudo String?

  // Todos los demás campos del Product de Zoho, tal cual (sin metadatos
  // internos $ de Zoho, que se filtran antes de guardar).
  datos Json?

  lastSyncedAt DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([proyecto])
  @@index([categoria])
  @@index([estado])
  @@index([referenciaRecaudo])
}

model EncargFiduciario {
  id            String                 @id @default(uuid())
  nombre        String
  codigo        String?
  archivoNombre String
  emailId       String?
  emailAsunto   String?
  emailFecha    DateTime?
  hojas         HojaFiduciaria[]
  movimientos   MovimientoFiduciario[]
  createdAt     DateTime               @default(now())

  @@index([codigo])
}

model HojaFiduciaria {
  id          String                 @id @default(uuid())
  encargId    String
  encargo     EncargFiduciario       @relation(fields: [encargId], references: [id], onDelete: Cascade)
  nombreHoja  String
  columnas    Json // string[]
  filas       Json // any[][]
  totalFilas  Int                    @default(0)
  movimientos MovimientoFiduciario[]
  createdAt   DateTime               @default(now())

  @@index([encargId])
}

model MovimientoFiduciario {
  id          String           @id @default(uuid())
  encargId    String
  encargo     EncargFiduciario @relation(fields: [encargId], references: [id], onDelete: Cascade)
  hojaId      String
  hoja        HojaFiduciaria   @relation(fields: [hojaId], references: [id], onDelete: Cascade)
  nombreHoja  String // desnormalizado para queries rápidas
  propietario String? // nombre del cliente/propietario detectado
  datos       Json // fila como { columna: valor }
  createdAt   DateTime         @default(now())

  @@index([encargId])
  @@index([propietario])
  @@index([encargId, propietario])
}

model Negocio {
  id          String              @id @default(uuid())
  referencia  String              @unique
  estado      String?
  datos       Json?
  saldoActual Float?
  compradores NegocioComprador[]
  movimientos NegocioMovimiento[]
  // Marcado manual desde Cartera en Gestión (clic derecho). "Canje" excluye
  // el negocio de la cartera por completo -- no es una deuda real (el
  // comprador está aportando otra cosa a cambio del apartamento).
  enTramite   Boolean             @default(false)
  esCanje     Boolean             @default(false)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@index([estado])
  @@index([saldoActual])
}

model NegocioComprador {
  id         String  @id @default(uuid())
  negocioId  String
  negocio    Negocio @relation(fields: [negocioId], references: [id], onDelete: Cascade)
  nombre     String
  nroId      String?
  porcentaje Float?
  orden      Int     @default(0)

  @@index([negocioId])
  @@index([nombre])
}

model NegocioMovimiento {
  id            String    @id @default(uuid())
  negocioId     String
  negocio       Negocio   @relation(fields: [negocioId], references: [id], onDelete: Cascade)
  referencia    String
  idMovimiento  String?   @unique
  fechaContable DateTime?
  datos         Json
  createdAt     DateTime  @default(now())

  @@index([negocioId])
  @@index([referencia])
  @@index([fechaContable])
}

model ZohoFieldMetadata {
  id          String   @id @default(uuid())
  apiName     String   @unique
  fieldLabel  String
  dataType    String
  sectionName String?
  isCustom    Boolean  @default(false)
  createdAt   DateTime @default(now())
}

model SyncLog {
  id          String    @id @default(uuid())
  startedAt   DateTime  @default(now())
  finishedAt  DateTime?
  status      String // 'success' | 'error' | 'running'
  recordsSync Int       @default(0)
  errorMsg    String?
}

// Fecha de entrega real por Frente + Torre + Piso (ej. "Kala" + "1" + "3"),
// para reemplazar la fecha estimada de la cuota Saldo Contraentrega -- por
// defecto esa fecha se infiere (mes siguiente a la penúltima cuota), pero
// cuando se conoce la fecha real de entrega, esta configuración la
// reemplaza en todos los cálculos de conciliación de los negocios
// correspondientes. Se puede configurar a tres niveles, mutuamente
// excluyentes entre sí: todo el proyecto, una torre completa, o un piso
// específico de una torre -- ver configuracionFrenteService.js.
model ConfiguracionFrente {
  id           String    @id @default(uuid())
  frente       String
  torre        String
  piso         String
  fechaEntrega DateTime?
  updatedAt    DateTime  @updatedAt

  @@unique([frente, torre, piso])
}

// Foto fija mensual del "Consolidado de Cartera por Etapa" de Resumen
// Gerencial -- réplica en vivo del Excel manual, pero el Excel congela cada
// mes en su propia hoja al cerrarlo, y nuestro cálculo es siempre en vivo
// (no hay forma de reconstruir con certeza cómo se veía el portafolio en un
// mes ya pasado). Este modelo guarda esa foto al cierre de cada mes (ver
// cron en index.js) para poder navegar "mes a mes" igual que las hojas del
// Excel. `mes` en formato "YYYY-MM"; `datos` es el mismo JSON que devuelve
// obtenerResumenPorEtapa() (`{ etapas, total }`).
model ResumenCarteraMensual {
  id        String   @id @default(uuid())
  mes       String   @unique
  datos     Json
  createdAt DateTime @default(now())
}

// Cuenta individual de acceso -- reemplaza la clave única compartida
// (APP_PASSWORD). `modulosPermitidos` reutiliza las mismas `key` de
// frontend/src/config/navItems.js (ver también backend/src/config/modulos.js).
// `esAdmin` da acceso a todos los módulos sin necesidad de listarlos, más la
// gestión de usuarios en Ajustes.
model Usuario {
  id                Int      @id @default(autoincrement())
  email             String   @unique
  nombre            String
  passwordHash      String
  esAdmin           Boolean  @default(false)
  activo            Boolean  @default(true)
  modulosPermitidos String[] @default([])
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  auditoriasComoActor    AuditoriaUsuario[] @relation("AuditoriaActor")
  auditoriasComoAfectado AuditoriaUsuario[] @relation("AuditoriaAfectado")
}

// Historial de acciones de administración sobre usuarios (crear, cambiar
// módulos, activar/desactivar, resetear contraseña, dar/quitar admin) --
// se escribe automáticamente desde routes/usuarios.js, nunca a mano.
model AuditoriaUsuario {
  id        Int      @id @default(autoincrement())
  actorId   Int
  actor     Usuario  @relation("AuditoriaActor", fields: [actorId], references: [id])
  usuarioId Int
  usuario   Usuario  @relation("AuditoriaAfectado", fields: [usuarioId], references: [id])
  accion    String
  detalle   Json?
  createdAt DateTime @default(now())
}
